{
  "name": "fandipres-site-build",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for fandipres.my.id - prerenders JS-driven content into static HTML for SEO.",
  "scripts": {
    "lint": "node build/lint-data.js",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.css --minify",
    "build": "node build/lint-data.js && node build/prerender.js && npm run build:css",
    "generate-assets": "node build/generate-og.js",
    "optimize-images": "node build/optimize-project-images.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17"
  }
}
